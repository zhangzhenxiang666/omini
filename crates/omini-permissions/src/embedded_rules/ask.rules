# 内置风险询问名单；显式用户规则可以覆盖，未命中命令默认放行。

prefix_rule(
  pattern = ["rm"],
  decision = "prompt",
  justification = "文件删除或数据破坏：rm",
)

prefix_rule(
  pattern = ["rmdir"],
  decision = "prompt",
  justification = "文件删除或数据破坏：rmdir",
)

