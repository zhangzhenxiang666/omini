prefix_rule(
  pattern = ["git", ["push", "reset", "clean", "restore"]],
  decision = "prompt",
  justification = "远端写入或破坏性 Git 操作",
)

prefix_rule(
  pattern = ["git", "branch", "-D"],
  decision = "prompt",
  justification = "强制删除 Git 分支",
)

prefix_rule(
  pattern = ["jj", "git", "push"],
  decision = "prompt",
  justification = "远端写入",
)

prefix_rule(
  pattern = ["jj", ["abandon", "restore", "undo"]],
  decision = "prompt",
  justification = "破坏性 Jujutsu 操作",
)

prefix_rule(
  pattern = ["jj", ["operation", "op"], "restore"],
  decision = "prompt",
  justification = "恢复 Jujutsu 历史操作",
)

prefix_rule(
  pattern = ["docker", "rm"],
  decision = "prompt",
  justification = "删除容器",
)

prefix_rule(
  pattern = ["docker", "system", "prune"],
  decision = "prompt",
  justification = "清理 Docker 资源",
