prefix_rule(
  pattern = ["gh", "issue", ["create", "edit", "close", "reopen", "delete", "comment"]],
  decision = "prompt",
  justification = "修改 GitHub Issue",
)

prefix_rule(
  pattern = ["gh", "pr", ["create", "edit", "merge", "close", "reopen", "comment"]],
  decision = "prompt",
  justification = "修改 GitHub PR",
)

prefix_rule(
  pattern = ["gh", "release", ["create", "delete", "edit"]],
  decision = "prompt",
  justification = "修改 GitHub Release",
)

prefix_rule(
  pattern = ["gh", "label", ["create", "edit", "delete"]],
  decision = "prompt",
  justification = "修改 GitHub Label",
)

prefix_rule(
  pattern = ["gh", "repo", ["create", "delete"]],
  decision = "prompt",
  justification = "修改 GitHub 仓库",
)

prefix_rule(
  pattern = ["gh", "workflow", "run"],
  decision = "prompt",
  justification = "触发 GitHub 工作流",
)

prefix_rule(
  pattern = ["gh", "run", ["cancel", "rerun"]],
  decision = "prompt",
  justification = "取消或重新运行 GitHub 工作流",
)

prefix_rule(
  pattern = [["diesel", "sqlx", "prisma", "sea-orm-cli"], ["migrate", "migration"]],
  decision = "prompt",
  justification = "数据库迁移",
)

# 提交创建、描述及内容整理也默认询问；包含 Jujutsu 内置别名。
prefix_rule(
  pattern = ["jj", ["commit", "ci", "describe", "desc", "new", "squash", "split", "absorb", "metaedit"]],
  decision = "prompt",
  justification = "创建或修改 Jujutsu 提交",
)
